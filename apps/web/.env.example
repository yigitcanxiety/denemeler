OPENROUTER_API_KEY=
ANALYSIS_MODEL=stealth/space-bunny-alpha      # swap to e.g. google/gemini-2.5-flash without code changes
ANALYSIS_FALLBACK_MODEL=google/gemini-2.5-flash
KIE_API_KEY=                                   # Kie.ai: used for analysis when OPENROUTER_API_KEY is empty, and for renders
KIE_ANALYSIS_MODEL=gemini-3-flash
KIE_IMAGE_MODEL=google/nano-banana-edit        # or nano-banana-2
IMAGE_PROVIDER=                                # gemini | fal | kie (empty: gemini if GEMINI_API_KEY is set, else kie)
GEMINI_API_KEY=                                # aistudio.google.com: used for analysis and try-on renders
GEMINI_ANALYSIS_MODEL=                         # default gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana/edit
REVENUECAT_SECRET_KEY=
TONELLE_MOCK=                                  # 1 forces mock mode
NEXT_PUBLIC_SITE_URL=https://tonelle.app
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
