# Base URL of the Tonelle API (apps/web). Use your LAN IP for a device, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://tonelle.app
# Marketing / legal site (privacy, kvkk, consent, terms pages)
EXPO_PUBLIC_SITE_URL=https://tonelle.app
# RevenueCat public SDK keys. Leave empty to run in local "dev purchases" mode.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
